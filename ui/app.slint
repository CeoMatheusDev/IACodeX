import { VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "IACodeX — Into the Unknown";
    width: 1280px;
    height: 726px;
    background: root.bg-main;
    callback send-prompt(string);
    callback cancel-prompt();
    in-out property <string> response-text: "";
    in-out property <bool> is-streaming: false;
    callback open-configuration-file();
    callback fetch-provider-models(string, string, string);
    callback edit-provider(string);
    callback edit-provider-model(string, string);
    in-out property <[string]> discovered-models: [];
    in-out property <[string]> saved-provider-models: [];
    in-out property <bool> provider-loading: false;
    in-out property <int> provider-health: 0;
    callback create-provider(string, string, string, string, string, string, string, string, string);
    pure callback model-matches(string, string) -> bool;
    callback select-configured-model(string);
    callback create-workspace(string);
    callback record-session(string, string);
    pure callback session-in-workspace(string, string) -> bool;
    pure callback session-title(string, string) -> string;
    in-out property <[string]> workspaces: [];
    in-out property <[string]> session-entries: [];
    in-out property <bool> create-workspace-open: false;
    in-out property <string> new-workspace-name: "";
    in-out property <bool> session-ready: false;
    in-out property <[string]> configured-models: [];
    in-out property <string> model-search: "";
    in-out property <bool> thinking-enabled: false;
    in-out property <bool> thinking-supported: false;
    in-out property <bool> provider-list-open: false;
    in-out property <string> provider-api-key: "";
    in-out property <string> provider-status: "";
    in-out property <bool> provider-custom: false;
    in-out property <string> provider-id: "";
    in-out property <string> provider-model-display: "";
    in-out property <string> provider-model-context: "";
    in-out property <string> provider-model-max-output: "";
    in-out property <bool> provider-model-added: false;
    in-out property <bool> provider-model-expanded: false;
    in-out property <bool> provider-editing-existing: false;
    in-out property <string> provider-protocol: "OpenAI-compatible";
    in-out property <bool> provider-protocol-open: false;
    callback save-settings(string, string, string, string, string, string, bool, bool, bool);
    in-out property <bool> plugin-shell: false;
    in-out property <bool> plugin-agent-loop: false;
    in-out property <bool> plugin-web-search: false;
    in-out property <string> provider-name: "";
    in-out property <string> provider-url: "";
    in-out property <string> provider-model: "";
    in-out property <string> provider-original-model: "";
    in-out property <bool> provider-editor: false;
    function persist-settings() { root.save-settings(root.active-mode, root.settings-permission, root.settings-language, root.settings-appearance, root.settings-enter, root.settings-provider, root.plugin-shell, root.plugin-agent-loop, root.plugin-web-search); }
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-language: "English";
    in-out property <string> settings-appearance: "System";
    in-out property <bool> system-dark: true;
    property <bool> dark-theme: root.settings-appearance == "Dark" || (root.settings-appearance == "System" && root.system-dark);
    property <bool> pt: root.settings-language == "Português";
    property <brush> bg-main: root.dark-theme ? #141416 : #f5f6f9;
    property <brush> bg-sidebar: root.dark-theme ? #1b1b1d : #e9ecf2;
    property <brush> bg-panel: root.dark-theme ? #2b2b2e : #ffffff;
    property <brush> bg-card: root.dark-theme ? #343438 : #eef0f5;
    property <brush> fg-main: root.dark-theme ? #f3f3f6 : #202633;
    property <brush> fg-muted: root.dark-theme ? #aaaaaf : #596273;
    property <brush> outline: root.dark-theme ? #4a4a51 : #cbd1dc;

    in-out property <string> settings-enter: "Queue";
    in-out property <string> settings-permission: "Full access";
    in-out property <string> settings-provider: "";
    in-out property <string> prompt-text: "";
    in-out property <string> active-workspace: "";
    in-out property <string> active-mode: "Standard mode";
    in-out property <string> active-model: "";
    in-out property <bool> show-sidebar: true;
    in-out property <bool> has-session: false;
    in-out property <bool> workspace-open: true;
    in-out property <bool> model-open: false;
    in-out property <bool> mode-open: false;
    in-out property <bool> access-open: false;
    in-out property <bool> workspace-menu-open: false;
    in-out property <string> session-name: "New Session";
    in-out property <string> session-workspace: "";

    HorizontalLayout {
        spacing: 0px;
        if root.show-sidebar: Rectangle {
            width: 282px;
            background: root.bg-sidebar;
            border-width: 1px;
            border-color: #27272b;
            VerticalLayout {
                padding: 16px;
                spacing: 0px;
                HorizontalLayout {
                    height: 42px;
                    spacing: 7px;
                    Text { text: "◆"; color: #8ea9e8; font-size: 22px; }
                    Text { text: "IACodeX"; color: root.fg-main; font-size: 19px; font-weight: 700; }
                    Rectangle {
                        width: 54px;
                        height: 15px;
                        background: #e6e7eb;
                        border-radius: 2px;
                        Text { text: "DESKTOP"; color: #232327; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "Hide"; color: #b8bed0; font-size: 12px; vertical-alignment: center; }
                    TouchArea { width: 20px; clicked => { root.show-sidebar = false; } }
                }
                Rectangle { height: 15px; background: #00000000; }
                Rectangle {
                    height: 38px;
                    background: root.active-workspace == "" ? #303036 : (new-session-touch.has-hover ? #505158 : #424349);
                    border-color: #55565e;
                    border-width: 1px;
                    border-radius: 12px;
                    Text { text: (root.pt ? "Nova sessão" : "New Session"); color: #f1f2f6; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 600; }
                    new-session-touch := TouchArea { clicked => { if root.active-workspace != "" { root.has-session = false; root.session-ready = true; root.prompt-text = ""; root.session-name = "New Session"; } } }
                }
                Rectangle { height: 15px; background: #00000000; }
                HorizontalLayout {
                    height: 34px;
                    Text { text: (root.pt ? "Espaços de trabalho" : "Workspaces"); color: #a7a8b0; font-size: 14px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Rectangle { width: 30px; background: workspace-add-touch.has-hover ? #343640 : transparent; border-radius: 7px; Text { text: "+"; color: #c9cbd4; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; } workspace-add-touch := TouchArea { clicked => { root.new-workspace-name = ""; root.create-workspace-open = true; } } }
                }
                if root.workspaces.length == 0: Rectangle {
                    height: 48px; background: #252832; border-radius: 10px;
                    border-width: 1px; border-color: #39445c;
                    Text { text: root.pt ? "Nenhum workspace ainda" : "No workspaces yet"; color: #b9c9e9; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                }
                for workspace in root.workspaces: Rectangle {
                    height: 38px; border-radius: 9px;
                    background: root.active-workspace == workspace ? #303f59 : (workspace-row.has-hover ? #2c303b : transparent);
                    Text { text: "▣  " + workspace; color: root.fg-main; x: 12px; vertical-alignment: center; font-size: 13px; }
                    workspace-row := TouchArea { clicked => { root.active-workspace = workspace; root.session-ready = false; root.has-session = false; root.prompt-text = ""; root.workspace-menu-open = false; } }
                }
                for entry in root.session-entries: Rectangle {
                    height: root.session-in-workspace(entry, root.active-workspace) && root.active-workspace != "" ? 30px : 0px;
                    background: session-row.has-hover ? #313440 : transparent;
                    border-radius: 7px;
                    Text { text: "    ↳  " + root.session-title(entry, root.active-workspace); color: root.fg-muted; x: 14px; font-size: 12px; vertical-alignment: center; }
                    session-row := TouchArea { clicked => {
                        root.session-name = root.session-title(entry, root.active-workspace);
                        root.has-session = true;
                        root.session-ready = true;
                    } }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                Rectangle {
                    height: 42px;
                    background: #303847;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #465675;
                    Text { text: (root.pt ? "Configurações" : "Settings"); color: #dce5f8; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
                    TouchArea { clicked => { root.settings-tab = 0; root.settings-open = true; } }
                }
            }
        }
        Rectangle {
            background: root.bg-main;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                if !root.show-sidebar: Rectangle {
                    height: 40px;
                    background: #00000000;
                    Text { text: "☰"; color: #dddde3; x: 18px; vertical-alignment: center; font-size: 22px; }
                    TouchArea { clicked => { root.show-sidebar = true; } }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    VerticalLayout {
                        width: min(760px, root.width - (root.show-sidebar ? 350px : 64px));
                        spacing: 18px;
                        HorizontalLayout {
                            height: 48px;
                            alignment: center;
                            spacing: 10px;
                            
                            Text { text: root.has-session ? root.session-name : "Into the Unknown"; color: root.fg-main; font-size: 24px; vertical-alignment: center; }
                            Rectangle {
                                width: 66px;
                                height: 22px;
                                background: #344058;
                                border-color: #465470;
                                border-width: 1px;
                                border-radius: 12px;
                                Text { text: (root.pt ? "Prévia" : "Preview"); color: #dce3f6; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            height: 28px;
                            spacing: 16px;
                            Rectangle {
                                width: 160px;
                                background: #303847;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #465675;
                                Text { text: (root.active-workspace == "" ? (root.pt ? "Sem workspace" : "No workspace") : root.active-workspace) + " ⌄"; color: #dfe8fa; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.workspace-menu-open = !root.workspace-menu-open; } }
                            }
                            Rectangle {
                                width: 165px;
                                background: #303039;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #454550;
                                Text { text: root.active-mode + " ⌄"; color: #e0e1e8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.mode-open = !root.mode-open; } }
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                        }
                        if root.workspace-menu-open: Rectangle {
                            height: root.workspaces.length == 0 ? 34px : min(180px, root.workspaces.length * 34px);
                            background: root.bg-panel; border-radius: 8px;
                            ScrollView {
                                VerticalLayout {
                                    for workspace in root.workspaces: Rectangle {
                                        height: 32px; background: workspace-menu-touch.has-hover ? #3a3e4b : root.bg-card;
                                        Text { text: workspace; color: root.fg-main; x: 10px; vertical-alignment: center; }
                                        workspace-menu-touch := TouchArea { clicked => { root.active-workspace = workspace; root.session-ready = false; root.has-session = false; root.workspace-menu-open = false; } }
                                    }
                                    if root.workspaces.length == 0: Text { text: root.pt ? "Crie um workspace no botão +" : "Create a workspace using +"; color: root.fg-muted; font-size: 12px; }
                                }
                            }
                        }
                        if root.mode-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "Standard mode       /       Plan mode"; color: root.fg-main; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { root.active-mode = root.active-mode == "Standard mode" ? "Plan mode" : "Standard mode"; root.persist-settings(); root.mode-open = false; } }
                        }
                        if root.response-text != "": Rectangle {
                            height: 160px;
                            background: root.bg-panel;
                            border-radius: 10px;
                            ScrollView {
                                Text {
                                    text: root.response-text;
                                    color: root.fg-main;
                                    wrap: word-wrap;
                                    font-size: 13px;
                                }
                            }
                        }
                        Rectangle {
                            height: 124px;
                            background: root.session-ready && root.active-workspace != "" ? #252528 : #1e1e22;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: #3d3d43;
                            VerticalLayout {
                                padding: 9px;
                                spacing: 4px;
                                LineEdit {
                                    enabled: root.session-ready && root.active-workspace != "";
                                    text <=> root.prompt-text;
                                    placeholder-text: (root.pt ? "Descreva o que deseja criar" : "Describe what you want to build");
                                    height: 64px;
                                    font-size: 15px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        background: #38383b;
                                        border-radius: 15px;
                                        Text { text: "+"; color: #e9eaf1; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 162px;
                                        background: access-button.has-hover ? #363740 : #2d2e35;
                                        border-radius: 17px;
                                        Text { text: (root.settings-permission == "Read Only" ? "🛡 " : root.settings-permission == "Workspace Write" ? "✎ " : "⚠ ") + root.settings-permission + " ⌄"; color: #d3d4db; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        access-button := TouchArea { clicked => { root.access-open = !root.access-open; root.model-open = false; } }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                    Rectangle {
                                        width: 188px;
                                        background: #00000000;
                                        Text { text: (root.active-model == "" ? (root.pt ? "Selecionar modelo" : "Select model") : root.active-model) + " ⌄"; color: #d3d4db; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        TouchArea { clicked => { root.model-open = !root.model-open; } }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        background: root.is-streaming ? #91534f : (send-area.has-hover ? #536fa4 : #425e91);
                                        border-radius: 17px;
                                        Text { text: root.is-streaming ? "■" : "↑"; color: #d3dce9; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                        send-area := TouchArea { enabled: root.session-ready && root.active-workspace != "";
                                            clicked => {
                                                if root.is-streaming {
                                                    root.cancel-prompt();
                                                } else if root.prompt-text != "" && root.session-ready && root.active-workspace != "" {
                                                    root.response-text = "";
                                                    root.is-streaming = true;
                                                    if root.session-ready && root.active-workspace != "" { root.send-prompt(root.prompt-text); }
                                                    if !root.has-session {
                                                        root.session-name = root.prompt-text;
                                                        root.record-session(root.active-workspace, root.session-name);
                                                    }
                                                    root.has-session = true;
                                                    root.prompt-text = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.model-open: Rectangle {
                            height: 214px; background: root.bg-panel; border-radius: 10px; border-width: 1px; border-color: root.outline;
                            VerticalLayout {
                                padding: 10px; spacing: 7px;
                                Text { text: root.pt ? "Selecionar modelo" : "Select model"; color: root.fg-main; font-size: 14px; font-weight: 600; }
                                LineEdit { text <=> root.model-search; placeholder-text: root.pt ? "Buscar modelos..." : "Search models..."; }
                                ScrollView {
                                    VerticalLayout {
                                        spacing: 4px;
                                        for model in root.configured-models: Rectangle {
                                            height: root.model-matches(model, root.model-search) ? 32px : 0px;
                                            background: root.active-model == model ? #465a83 : root.bg-card;
                                            border-radius: 6px;
                                            Text { text: model; color: root.fg-main; x: 10px; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.active-model = model; root.model-open = false; root.thinking-enabled = false; root.select-configured-model(model); } }
                                        }
                                        if root.configured-models.length == 0: Text {
                                            text: root.pt ? "Adicione modelos em Settings → Models" : "Add models in Settings → Models";
                                            color: root.fg-muted; font-size: 12px;
                                        }
                                    }
                                }
                                if root.thinking-supported: Rectangle {
                                    height: 30px; background: root.bg-card; border-radius: 6px;
                                    Text { text: (root.pt ? "Pensamento" : "Thinking") + (root.thinking-enabled ? "  ON" : "  OFF"); color: root.fg-main; x: 10px; vertical-alignment: center; }
                                    TouchArea { clicked => { root.thinking-enabled = !root.thinking-enabled; } }
                                }
                            }
                        }
                        if root.access-open: Rectangle {
                            height: 126px;
                            background: root.bg-panel;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: root.outline;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 3px;
                                for option in ["Read Only", "Workspace Write", "Full access"]: Rectangle {
                                    height: 34px;
                                    border-radius: 7px;
                                    background: permission-touch.has-hover ? #41444f : (root.settings-permission == option ? #363d4c : root.bg-card);
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 30px;
                                            background: transparent;
                                            Text { text: option == "Read Only" ? "🛡" : option == "Workspace Write" ? "🛡✎" : "🛡!"; color: option == "Full access" ? #efab72 : #a5c5ef; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Text { text: option; color: root.fg-main; font-size: 13px; vertical-alignment: center; }
                                    }
                                    permission-touch := TouchArea {
                                        clicked => {
                                            root.settings-permission = option;
                                            root.access-open = false;
                                            root.persist-settings();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
                Rectangle { vertical-stretch: 1.15; background: #00000000; }
            }
        }
    }
    if root.create-workspace-open: Rectangle {
        background: #050509cc;
        TouchArea { clicked => { root.create-workspace-open = false; } }
        Rectangle {
            width: 440px; height: 210px; background: root.bg-panel;
            border-radius: 14px; border-width: 1px; border-color: root.outline;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 20px; spacing: 14px;
                Text { text: root.pt ? "Criar workspace" : "Create workspace"; color: root.fg-main; font-size: 19px; font-weight: 600; }
                LineEdit { text <=> root.new-workspace-name; placeholder-text: root.pt ? "Nome do workspace" : "Workspace name"; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 100px; background: #383b45; border-radius: 8px;
                        Text { text: root.pt ? "Cancelar" : "Cancel"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.create-workspace-open = false; } }
                    }
                    Rectangle {
                        width: 110px; background: #4a638c; border-radius: 8px;
                        Text { text: root.pt ? "Criar" : "Create"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            if root.new-workspace-name != "" {
                                root.create-workspace(root.new-workspace-name);
                                root.create-workspace-open = false;
                            }
                        } }
                    }
                }
            }
        }
    }
    if root.settings-open: Rectangle {
        background: #08080bc9;
        TouchArea { clicked => { root.persist-settings(); root.settings-open = false; } }
        Rectangle {
            width: min(800px, parent.width - 48px);
            height: min(678px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.bg-panel;
            border-radius: 22px;
            border-width: 1px;
            border-color: #414146;
            TouchArea { }
            VerticalLayout {
                padding: 22px;
                spacing: 18px;
                HorizontalLayout {
                    height: 28px;
                    Text { text: (root.pt ? "Configurações" : "Settings"); color: root.fg-main; font-size: 17px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 175px; background: #343439; border-radius: 14px;
                        Text { text: (root.pt ? "Abrir arquivo de configuração" : "Open configuration file"); color: #c5c5ce; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.persist-settings(); root.open-configuration-file(); } }
                    }
                    Rectangle {
                        width: 34px; background: transparent;
                        Text { text: "×"; color: #ededf2; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.persist-settings(); root.settings-open = false; } }
                    }
                }
                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        width: 164px;
                        spacing: 6px;
                        for item[i] in ["General", "Models", "Plugins", "Agent presets"]: Rectangle {
                            height: 40px;
                            border-radius: 9px;
                            background: root.settings-tab == i ? #45464c : transparent;
                            Text { text: item; x: 13px; color: root.settings-tab == i ? #ffffff : #d4d4da; font-size: 14px; vertical-alignment: center; }
                            TouchArea { clicked => { root.settings-tab = i; } }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                    Rectangle {
                        background: transparent;
                        VerticalLayout {
                            spacing: 12px;
                            if root.settings-tab == 0: VerticalLayout {
                                spacing: 13px;
                                Text { text: (root.pt ? "Geral" : "General"); color: root.fg-main; font-size: 19px; font-weight: 600; }
                                Text { text: (root.pt ? "Configurações padrão para novas sessões" : "Default settings for new sessions"); color: root.fg-muted; font-size: 12px; }
                                Rectangle {
                                    height: 67px; background: root.bg-card; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        VerticalLayout {
                                            Text { text: (root.pt ? "Perfil de agente" : "Agent preset"); color: root.fg-main; font-size: 14px; }
                                            Text { text: (root.pt ? "Escolha o modo padrão do agente" : "Choose the default agent mode"); color: root.fg-muted; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.active-mode + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.active-mode = root.active-mode == "Standard mode" ? "Plan mode" : "Standard mode"; } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 67px; background: root.bg-card; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        VerticalLayout {
                                            Text { text: (root.pt ? "Permissão" : "Permission"); color: root.fg-main; font-size: 14px; }
                                            Text { text: (root.pt ? "Nível de permissão padrão" : "Default permission level"); color: root.fg-muted; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-permission + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-permission = root.settings-permission == "Full access" ? "Ask first" : "Full access"; root.persist-settings(); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 56px; background: root.bg-card; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: (root.pt ? "Idioma" : "Language"); color: root.fg-main; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-language + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-language = root.settings-language == "English" ? "Português" : "English"; root.persist-settings(); } }
                                        }
                                    }
                                }
                                Text { text: (root.pt ? "Aparência" : "Appearance"); color: root.fg-main; font-size: 14px; }
                                HorizontalLayout {
                                    height: 82px; spacing: 9px;
                                    for theme in ["Light", "Dark", "System"]: Rectangle {
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: root.settings-appearance == theme ? #9da7c4 : #4b4b51;
                                        background: root.settings-appearance == theme ? #414149 : #333337;
                                        Text { text: theme; color: root.fg-main; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.settings-appearance = theme; root.persist-settings(); } }
                                    }
                                }
                                Rectangle {
                                    height: 62px; background: root.bg-card; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: (root.pt ? "Comportamento do Enter durante execução" : "Enter behavior while busy"); color: root.fg-main; font-size: 13px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 120px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-enter + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-enter = root.settings-enter == "Queue" ? "Send" : "Queue"; root.persist-settings(); } }
                                        }
                                    }
                                }
                            }
                            if root.settings-tab == 1: VerticalLayout {
                                spacing: 14px;
                                Text { text: (root.pt ? "Modelos" : "Models"); color: root.fg-main; font-size: 19px; font-weight: 600; }
                                Text { text: (root.pt ? "Adicione um provedor para configurar a API e os modelos." : "Add a provider to configure its API and available models."); color: root.fg-muted; font-size: 12px; }
                                if root.settings-provider != "": Rectangle {
                                    height: 56px; background: root.bg-card; border-radius: 11px;
                                    border-width: 1px; border-color: root.outline;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        Text { text: root.settings-provider; color: root.fg-main; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle { width: 12px; height: 12px; border-radius: 6px;
                                            background: root.provider-health == 1 ? #42cf77 : (root.provider-health == 2 ? #e85e61 : #e5ba4f);
                                        }
                                        Text { text: root.provider-health == 1 ? "Online" : (root.provider-health == 2 ? "Error" : "Unchecked"); color: root.fg-muted; font-size: 12px; vertical-alignment: center; }
                                        Rectangle {
                                            width: 54px; background: #414148; border-radius: 12px;
                                            Text { text: root.pt ? "Editar" : "Edit"; color: root.fg-main; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.edit-provider(root.settings-provider); } }
                                        }
                                        Rectangle {
                                            width: 66px; background: #414148; border-radius: 12px;
                                            Text { text: (root.pt ? "Remover" : "Remove"); color: #f0d3d5; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.settings-provider = ""; root.provider-editor = false; root.persist-settings(); } }
                                        }
                                    }
                                }
                                if root.settings-provider == "": Rectangle {
                                    height: 170px; background: root.bg-card; border-radius: 12px;
                                    border-width: 1px; border-color: root.outline;
                                    VerticalLayout {
                                        alignment: center; spacing: 8px;
                                        Text { text: (root.pt ? "Nenhum provedor configurado" : "No providers configured"); color: #e5e5ea; font-size: 15px; horizontal-alignment: center; }
                                        Text { text: (root.pt ? "Adicione ou crie um provedor personalizado." : "Add a provider or create a custom one to get started."); color: #a5a5af; font-size: 12px; horizontal-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    height: 46px; spacing: 12px;
                                    Rectangle {
                                        border-radius: 11px; border-width: 1px; border-color: #595963;
                                        background: #393940;
                                        Text { text: (root.pt ? "+ Adicionar provedor" : "+ Add provider"); color: #f0f0f4; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.provider-name = ""; root.provider-url = ""; root.provider-model = ""; root.provider-model-display = ""; root.provider-model-context = ""; root.provider-model-max-output = ""; root.provider-model-added = false; root.provider-model-expanded = false; root.provider-api-key = ""; root.provider-status = ""; root.provider-custom = false; root.provider-id = ""; root.provider-editing-existing = false; root.saved-provider-models = []; root.discovered-models = []; root.provider-editor = true; } }
                                    }
                                    Rectangle {
                                        border-radius: 11px; border-width: 1px; border-color: #595963;
                                        background: #393940;
                                        Text { text: (root.pt ? "+ Criar provedor personalizado" : "+ Add a custom provider"); color: #f0f0f4; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.provider-name = ""; root.provider-url = ""; root.provider-model = ""; root.provider-model-display = ""; root.provider-model-context = ""; root.provider-model-max-output = ""; root.provider-model-added = false; root.provider-model-expanded = false; root.provider-api-key = ""; root.provider-status = ""; root.provider-custom = true; root.provider-id = ""; root.provider-protocol = "OpenAI-compatible"; root.provider-editor = true; } }
                                    }
                                }
                            }
                            if root.settings-tab == 2: VerticalLayout {
                                spacing: 12px;
                                Text { text: (root.pt ? "Plugins" : "Plugins"); color: root.fg-main; font-size: 19px; font-weight: 600; }
                                Text { text: (root.pt ? "Ative ou desative as preferências de plugins. Integração pendente." : "Enable or disable plugin preferences. Runtime integrations are not yet available."); color: root.fg-muted; font-size: 12px; wrap: word-wrap; }
                                for plugin[i] in ["Shell", "Agent loop", "Web search"]: Rectangle {
                                    height: 74px; background: root.bg-card; border-radius: 12px;
                                    border-width: 1px; border-color: root.outline;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 10px;
                                        VerticalLayout {
                                            Text { text: plugin; color: root.fg-main; font-size: 15px; font-weight: 600; }
                                            Text { text: (root.pt ? "Apenas preferência — integração pendente" : "Preference only — integration pending"); color: root.fg-muted; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 80px; background: (i == 0 ? root.plugin-shell : i == 1 ? root.plugin-agent-loop : root.plugin-web-search) ? #49648b : root.outline;
                                            border-radius: 12px;
                                            Text { text: (i == 0 ? root.plugin-shell : i == 1 ? root.plugin-agent-loop : root.plugin-web-search) ? "On" : "Off"; color: root.fg-main; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => {
                                                if i == 0 { root.plugin-shell = !root.plugin-shell; }
                                                else if i == 1 { root.plugin-agent-loop = !root.plugin-agent-loop; }
                                                else { root.plugin-web-search = !root.plugin-web-search; }
                                                root.persist-settings();
                                            } }
                                        }
                                    }
                                }
                            }
                            if root.settings-tab == 3: VerticalLayout {
                                spacing: 12px;
                                Text { text: (root.pt ? "Perfis de agente" : "Agent presets"); color: root.fg-main; font-size: 19px; font-weight: 600; }
                                Text { text: (root.pt ? "Escolha um perfil para as próximas sessões." : "Choose a preset for future sessions (preview)."); color: root.fg-muted; font-size: 12px; }
                                for preset in ["Standard mode", "PTC mode", "Minimal mode", "Creator mode"]: Rectangle {
                                    height: 66px; background: root.bg-card; border-radius: 12px;
                                    border-width: 1px; border-color: root.active-mode == preset ? #8d9bbd : root.outline;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: preset; color: root.fg-main; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.active-mode == preset ? "Selected" : "Select"; color: #b8c4e1; font-size: 12px; vertical-alignment: center; }
                                    }
                                    TouchArea { clicked => { root.active-mode = preset; root.persist-settings(); } }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }
    }

    if root.settings-open && root.provider-editor: Rectangle {
        background: #050509d9;
        TouchArea { enabled: false; }
        Rectangle {
            width: min(520px, parent.width - 36px);
            height: min(root.provider-custom ? 690px : 590px, parent.height - 36px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.bg-panel;
            border-radius: 18px;
            border-width: 1px;
            border-color: root.outline;
            TouchArea { }
            VerticalLayout {
                padding: 20px; spacing: 9px;
                HorizontalLayout {
                    height: 34px;
                    Text { text: root.provider-custom ? (root.pt ? "Criar provedor personalizado" : "Create custom provider") : (root.pt ? "Adicionar provedor" : "Add provider"); color: root.fg-main; font-size: 19px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                if root.provider-custom: VerticalLayout {
                    spacing: 5px;
                    Text { text: "Provider ID"; color: root.fg-main; font-size: 13px; }
                    LineEdit { text <=> root.provider-id; placeholder-text: "my-provider"; }
                }
                Text { text: "Provider name"; color: root.fg-main; font-size: 13px; }
                if !root.provider-custom: Rectangle {
                    height: 38px; background: root.bg-card; border-radius: 9px; border-width: 1px; border-color: root.outline;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text { text: root.provider-name == "" ? "Select provider" : root.provider-name; color: root.fg-main; vertical-alignment: center; font-size: 14px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "⌄"; color: root.fg-main; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.provider-list-open = !root.provider-list-open; } }
                }
                if root.provider-list-open && !root.provider-custom: Rectangle {
                    height: 150px; background: root.bg-card; border-radius: 10px;
                    ScrollView {
                        VerticalLayout {
                            spacing: 2px;
                            for provider in ["DeepSeek", "OpenAI", "Anthropic", "Google Gemini", "OpenRouter", "Groq", "Mistral AI", "Cohere", "Together AI", "Fireworks AI", "Perplexity", "xAI", "Ollama", "LM Studio", "Azure OpenAI", "Custom"]: Rectangle {
                                height: 32px; background: #41414a; border-radius: 5px;
                                Text { text: provider; color: white; font-size: 13px; vertical-alignment: center; x: 12px; }
                                TouchArea { clicked => {
                                    root.provider-name = provider;
                                    root.provider-custom = provider == "Custom";
                                    root.provider-url = provider == "DeepSeek" ? "https://api.deepseek.com" :
                                        provider == "OpenAI" ? "https://api.openai.com/v1" :
                                        provider == "Anthropic" ? "https://api.anthropic.com/v1" :
                                        provider == "Google Gemini" ? "https://generativelanguage.googleapis.com/v1beta" :
                                        provider == "OpenRouter" ? "https://openrouter.ai/api/v1" :
                                        provider == "Groq" ? "https://api.groq.com/openai/v1" :
                                        provider == "Mistral AI" ? "https://api.mistral.ai/v1" :
                                        provider == "Cohere" ? "https://api.cohere.com/v2" :
                                        provider == "Together AI" ? "https://api.together.xyz/v1" :
                                        provider == "Fireworks AI" ? "https://api.fireworks.ai/inference/v1" :
                                        provider == "Perplexity" ? "https://api.perplexity.ai" :
                                        provider == "xAI" ? "https://api.x.ai/v1" :
                                        provider == "Ollama" ? "http://localhost:11434/v1" :
                                        provider == "LM Studio" ? "http://localhost:1234/v1" : "";
                                    root.provider-model = "";
                                    root.provider-status = "";
                                    root.provider-list-open = false;
                                } }
                            }
                        }
                    }
                }
                if root.provider-custom: LineEdit { text <=> root.provider-name; placeholder-text: "Custom provider name"; }
                Text { text: "API key"; color: root.fg-main; font-size: 13px; }
                LineEdit { text <=> root.provider-api-key; placeholder-text: "API key (saved locally)"; input-type: password; }
                Text { text: "Base URL"; color: root.fg-main; font-size: 13px; }
                LineEdit { text <=> root.provider-url; placeholder-text: "https://api.example.com/v1"; }
                if root.provider-custom: VerticalLayout {
                    spacing: 5px;
                    Text { text: "API protocol"; color: root.fg-main; font-size: 13px; }
                    Rectangle {
                        height: 36px; background: root.bg-card; border-radius: 9px; border-width: 1px; border-color: root.outline;
                        Text { text: root.provider-protocol + " ⌄"; color: root.fg-main; vertical-alignment: center; x: 12px; }
                        TouchArea { clicked => { root.provider-protocol-open = !root.provider-protocol-open; } }
                    }
                    if root.provider-protocol-open: Rectangle {
                        height: 72px; background: root.bg-card; border-radius: 9px;
                        VerticalLayout {
                            for protocol in ["OpenAI-compatible", "Anthropic"]: Rectangle {
                                height: 34px; background: #41414a;
                                Text { text: protocol; color: white; x: 10px; vertical-alignment: center; }
                                TouchArea { clicked => { root.provider-protocol = protocol; root.provider-protocol-open = false; } }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px; spacing: 8px;
                    Text { text: "Models"; color: root.fg-main; font-size: 13px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 164px; background: #3d485f; border-radius: 9px;
                        Text { text: root.provider-loading ? "Loading..." : "Fetch available models"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { enabled: !root.provider-loading; clicked => {
                            root.provider-loading = true;
                            root.provider-status = "Checking provider and loading models...";
                            root.provider-health = 0;
                            root.fetch-provider-models(root.provider-url, root.provider-api-key, root.provider-protocol);
                        } }
                    }
                }
                if root.saved-provider-models.length > 0: Rectangle {
                    height: min(152px, root.saved-provider-models.length * 36px);
                    background: root.bg-card; border-radius: 8px;
                    ScrollView {
                        VerticalLayout {
                            for model in root.saved-provider-models: Rectangle {
                                height: 34px; background: root.bg-card;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    Text { text: model; color: root.fg-main; font-size: 12px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        width: 48px; background: #434650; border-radius: 6px;
                                        Text { text: "Edit"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.edit-provider-model(root.provider-id, model); } }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.discovered-models.length > 0: Rectangle {
                    height: min(156px, root.discovered-models.length * 34px);
                    background: root.bg-card; border-radius: 8px;
                    ScrollView {
                        VerticalLayout {
                            for model in root.discovered-models: Rectangle {
                                height: 32px; background: root.bg-card;
                                Text { text: model; color: root.fg-main; font-size: 12px; x: 8px; vertical-alignment: center; }
                                TouchArea { clicked => { root.provider-model = model; root.provider-model-added = true; root.provider-status = "Selected: " + model; } }
                            }
                        }
                    }
                }
                if root.provider-model-added: Rectangle {
                    height: root.provider-model-expanded ? 160px : 120px;
                    background: root.bg-card;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.outline;
                    VerticalLayout {
                        padding: 9px; spacing: 6px;
                        HorizontalLayout {
                            height: 30px; spacing: 8px;
                            Text { text: "Model ID"; color: root.fg-muted; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle {
                                width: 30px; background: #434650; border-radius: 6px;
                                Text { text: root.provider-model-expanded ? "⌄" : ">"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.provider-model-expanded = !root.provider-model-expanded; } }
                            }
                            Rectangle {
                                width: 30px; background: #63363c; border-radius: 6px;
                                Text { text: "🗑"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.provider-model-added = false; root.provider-model = ""; root.provider-model-display = ""; root.provider-model-context = ""; root.provider-model-max-output = ""; root.provider-model-expanded = false; } }
                            }
                        }
                        LineEdit { text <=> root.provider-model; placeholder-text: "Model ID"; }
                        LineEdit { text <=> root.provider-model-display; placeholder-text: "Display name"; }
                        if root.provider-model-expanded: HorizontalLayout {
                            height: 32px; spacing: 8px;
                            LineEdit { text <=> root.provider-model-context; placeholder-text: "Context window"; }
                            LineEdit { text <=> root.provider-model-max-output; placeholder-text: "Max output tokens"; }
                        }
                    }
                }
                Rectangle {
                    height: 34px; background: #393b45; border-radius: 9px;
                    Text { text: "+ Add model"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.provider-model-added = true; root.provider-model-expanded = false; root.provider-model = ""; root.provider-original-model = ""; root.provider-model-display = ""; root.provider-model-context = ""; root.provider-model-max-output = ""; } }
                }
                if root.provider-status != "": Text { text: root.provider-status; color: root.fg-muted; font-size: 12px; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    height: 40px; spacing: 12px;
                    Rectangle {
                        background: #41414a; border-radius: 9px;
                        Text { text: "Cancel"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.provider-editor = false; root.provider-list-open = false; } }
                    }
                    Rectangle {
                        background: #4a638c; border-radius: 9px;
                        Text { text: root.provider-custom ? "Create provider" : "Apply"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            if root.provider-name != "" && root.provider-url != "" && (root.provider-api-key != "" || root.provider-editing-existing) && (root.saved-provider-models.length > 0 || root.discovered-models.length > 0 || root.provider-model != "") && (!root.provider-custom || root.provider-id != "" || root.provider-editing-existing) {
                                root.settings-provider = root.provider-name;
                                root.create-provider(root.provider-id, root.provider-name, root.provider-url, root.provider-protocol, root.provider-api-key, root.provider-model, root.provider-model-display, root.provider-model-context, root.provider-model-max-output);
                                root.provider-editor = false;
                                root.provider-list-open = false;
                                root.persist-settings();
                            } else {
                                root.provider-status = "Provider name, Base URL, API key and at least one model are required.";
                            }
                        } }
                    }
                }
            }
        }
    }

}
