import { VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "IACodeX — Into the Unknown";
    width: 1280px;
    height: 726px;
    background: #141416;
    callback send-prompt(string);
    in-out property <string> prompt-text: "";
    in-out property <string> active-workspace: "VorynOS";
    in-out property <string> active-mode: "Standard mode";
    in-out property <string> active-model: "deepseek-v4-flash:free";
    in-out property <bool> show-sidebar: true;
    in-out property <bool> has-session: false;
    in-out property <bool> workspace-open: true;
    in-out property <bool> model-open: false;
    in-out property <bool> mode-open: false;
    in-out property <bool> access-open: false;
    in-out property <bool> workspace-menu-open: false;
    in-out property <string> session-name: "New Session";

    HorizontalLayout {
        spacing: 0px;
        if root.show-sidebar: Rectangle {
            width: 282px;
            background: #1b1b1d;
            border-width: 1px;
            border-color: #27272b;
            VerticalLayout {
                padding: 16px;
                spacing: 0px;
                HorizontalLayout {
                    height: 42px;
                    spacing: 7px;
                    Text { text: "◈"; color: #f6f6f8; font-size: 25px; }
                    Text { text: "IACodeX"; color: #f5f5f7; font-size: 19px; font-weight: 700; }
                    Rectangle {
                        width: 54px;
                        height: 15px;
                        background: #e6e7eb;
                        border-radius: 2px;
                        Text { text: "DESKTOP"; color: #232327; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "◧"; color: #c2c4ca; font-size: 19px; }
                    TouchArea { width: 20px; clicked => { root.show-sidebar = false; } }
                }
                Rectangle { height: 15px; background: #00000000; }
                Rectangle {
                    height: 38px;
                    background: new-session-touch.has-hover ? #505158 : #424349;
                    border-color: #55565e;
                    border-width: 1px;
                    border-radius: 12px;
                    HorizontalLayout { alignment: center; spacing: 8px; Image { source: @image-url("../adicionar.png"); width: 17px; height: 17px; image-fit: contain; } Text { text: "New Session"; color: #e8e9ec; vertical-alignment: center; font-size: 14px; } }
                    new-session-touch := TouchArea { clicked => { root.has-session = false; root.prompt-text = ""; root.session-name = "New Session"; } }
                }
                Rectangle { height: 15px; background: #00000000; }
                HorizontalLayout {
                    height: 34px;
                    Text { text: "Workspaces"; color: #a7a8b0; font-size: 14px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "+"; color: #c9cbd4; font-size: 23px; vertical-alignment: center; }
                }
                Rectangle {
                    height: 48px;
                    background: #202023;
                    border-radius: 10px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Image { source: @image-url("../add-project.png"); width: 19px; height: 19px; image-fit: contain; }
                        Text { text: "No projects yet"; color: #999ba5; font-size: 13px; vertical-alignment: center; }
                    }
                }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                Rectangle {
                    height: 42px;
                    background: #00000000;
                    HorizontalLayout { spacing: 9px; Image { source: @image-url("../setting.png"); width: 19px; height: 19px; image-fit: contain; } Text { text: "Settings"; color: #e0e1e6; vertical-alignment: center; font-size: 14px; } }
                }
            }
        }
        Rectangle {
            background: #141416;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                if !root.show-sidebar: Rectangle {
                    height: 40px;
                    background: #00000000;
                    Text { text: "☰"; color: #dddde3; x: 18px; vertical-alignment: center; font-size: 22px; }
                    TouchArea { clicked => { root.show-sidebar = true; } }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    VerticalLayout {
                        width: min(760px, root.width - (root.show-sidebar ? 350px : 64px));
                        spacing: 18px;
                        HorizontalLayout {
                            height: 48px;
                            alignment: center;
                            spacing: 10px;
                            Text { text: "◈"; color: #a9baf5; font-size: 29px; vertical-alignment: center; }
                            Text { text: root.has-session ? root.session-name : "Into the Unknown"; color: #f0f0f3; font-size: 24px; vertical-alignment: center; }
                            Rectangle {
                                width: 66px;
                                height: 22px;
                                background: #344058;
                                border-color: #465470;
                                border-width: 1px;
                                border-radius: 12px;
                                Text { text: "Preview"; color: #dce3f6; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            height: 28px;
                            spacing: 16px;
                            Rectangle {
                                width: 100px;
                                background: #00000000;
                                HorizontalLayout { spacing: 6px; Image { source: @image-url("../project.png"); width: 16px; height: 16px; image-fit: contain; } Text { text: root.active-workspace + " ⌄"; color: #d6d7dd; font-size: 13px; vertical-alignment: center; } }
                                TouchArea { clicked => { root.workspace-menu-open = !root.workspace-menu-open; } }
                            }
                            Rectangle {
                                width: 150px;
                                background: #00000000;
                                Text { text: "♧  " + root.active-mode + " ⌄"; color: #d6d7dd; font-size: 13px; vertical-alignment: center; }
                                TouchArea { clicked => { root.mode-open = !root.mode-open; } }
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                        }
                        if root.workspace-menu-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "VorynOS       /       Ungrouped"; color: #ededf0; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { root.active-workspace = root.active-workspace == "VorynOS" ? "Ungrouped" : "VorynOS"; root.workspace-menu-open = false; } }
                        }
                        if root.mode-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "Standard mode       /       Plan mode"; color: #ededf0; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { root.active-mode = root.active-mode == "Standard mode" ? "Plan mode" : "Standard mode"; root.mode-open = false; } }
                        }
                        Rectangle {
                            height: 124px;
                            background: #252528;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: #3d3d43;
                            VerticalLayout {
                                padding: 9px;
                                spacing: 4px;
                                LineEdit {
                                    text <=> root.prompt-text;
                                    placeholder-text: "Describe what you want to build";
                                    height: 64px;
                                    font-size: 15px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        background: #38383b;
                                        border-radius: 15px;
                                        Image { source: @image-url("../adicionar-arquivo.png"); width: 20px; height: 20px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; image-fit: contain; }
                                    }
                                    Rectangle {
                                        width: 130px;
                                        background: #00000000;
                                        Text { text: "Full access ⌄"; color: #d3d4db; font-size: 13px; vertical-alignment: center; }
                                        TouchArea { clicked => { root.access-open = !root.access-open; } }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                    Rectangle {
                                        width: 188px;
                                        background: #00000000;
                                        Text { text: root.active-model + " ⌄"; color: #d3d4db; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        TouchArea { clicked => { root.model-open = !root.model-open; } }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        background: send-area.has-hover ? #536fa4 : #425e91;
                                        border-radius: 17px;
                                        Text { text: "↑"; color: #d3dce9; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                        send-area := TouchArea {
                                            clicked => {
                                                if root.prompt-text != "" {
                                                    root.send-prompt(root.prompt-text);
                                                    root.session-name = root.prompt-text;
                                                    root.has-session = true;
                                                    root.prompt-text = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.model-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "deepseek-v4-flash:free   /   Custom model"; color: #ededf0; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.active-model = root.active-model == "deepseek-v4-flash:free" ? "Custom model" : "deepseek-v4-flash:free"; root.model-open = false; } }
                        }
                        if root.access-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "Full access (visual only — no system permissions)"; color: #ededf0; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.access-open = false; } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
                Rectangle { vertical-stretch: 1.15; background: #00000000; }
            }
        }
    }
}
