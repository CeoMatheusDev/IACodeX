import { VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "IACodeX — Into the Unknown";
    width: 1280px;
    height: 726px;
    background: #141416;
    callback send-prompt(string);
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-language: "English";
    in-out property <string> settings-appearance: "System";
    in-out property <string> settings-enter: "Queue";
    in-out property <string> settings-permission: "Full access";
    in-out property <string> settings-provider: "";
    in-out property <string> prompt-text: "";
    in-out property <string> active-workspace: "VorynOS";
    in-out property <string> active-mode: "Standard mode";
    in-out property <string> active-model: "deepseek-v4-flash:free";
    in-out property <bool> show-sidebar: true;
    in-out property <bool> has-session: false;
    in-out property <bool> workspace-open: true;
    in-out property <bool> model-open: false;
    in-out property <bool> mode-open: false;
    in-out property <bool> access-open: false;
    in-out property <bool> workspace-menu-open: false;
    in-out property <string> session-name: "New Session";

    HorizontalLayout {
        spacing: 0px;
        if root.show-sidebar: Rectangle {
            width: 282px;
            background: #1b1b1d;
            border-width: 1px;
            border-color: #27272b;
            VerticalLayout {
                padding: 16px;
                spacing: 0px;
                HorizontalLayout {
                    height: 42px;
                    spacing: 7px;
                    Text { text: "◆"; color: #8ea9e8; font-size: 22px; }
                    Text { text: "IACodeX"; color: #f5f5f7; font-size: 19px; font-weight: 700; }
                    Rectangle {
                        width: 54px;
                        height: 15px;
                        background: #e6e7eb;
                        border-radius: 2px;
                        Text { text: "DESKTOP"; color: #232327; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "Hide"; color: #b8bed0; font-size: 12px; vertical-alignment: center; }
                    TouchArea { width: 20px; clicked => { root.show-sidebar = false; } }
                }
                Rectangle { height: 15px; background: #00000000; }
                Rectangle {
                    height: 38px;
                    background: new-session-touch.has-hover ? #505158 : #424349;
                    border-color: #55565e;
                    border-width: 1px;
                    border-radius: 12px;
                    Text { text: "New Session"; color: #f1f2f6; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 600; }
                    new-session-touch := TouchArea { clicked => { root.has-session = false; root.prompt-text = ""; root.session-name = "New Session"; } }
                }
                Rectangle { height: 15px; background: #00000000; }
                HorizontalLayout {
                    height: 34px;
                    Text { text: "Workspaces"; color: #a7a8b0; font-size: 14px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "+"; color: #c9cbd4; font-size: 23px; vertical-alignment: center; }
                }
                Rectangle {
                    height: 48px;
                    background: #252832;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #39445c;
                    Text { text: "No projects yet"; color: #b9c9e9; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                }
                                Rectangle { vertical-stretch: 1; background: #00000000; }
                Rectangle {
                    height: 42px;
                    background: #303847;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #465675;
                    Text { text: "Settings"; color: #dce5f8; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
                    TouchArea { clicked => { root.settings-tab = 0; root.settings-open = true; } }
                }
            }
        }
        Rectangle {
            background: #141416;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                if !root.show-sidebar: Rectangle {
                    height: 40px;
                    background: #00000000;
                    Text { text: "☰"; color: #dddde3; x: 18px; vertical-alignment: center; font-size: 22px; }
                    TouchArea { clicked => { root.show-sidebar = true; } }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    VerticalLayout {
                        width: min(760px, root.width - (root.show-sidebar ? 350px : 64px));
                        spacing: 18px;
                        HorizontalLayout {
                            height: 48px;
                            alignment: center;
                            spacing: 10px;
                            
                            Text { text: root.has-session ? root.session-name : "Into the Unknown"; color: #f0f0f3; font-size: 24px; vertical-alignment: center; }
                            Rectangle {
                                width: 66px;
                                height: 22px;
                                background: #344058;
                                border-color: #465470;
                                border-width: 1px;
                                border-radius: 12px;
                                Text { text: "Preview"; color: #dce3f6; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            height: 28px;
                            spacing: 16px;
                            Rectangle {
                                width: 160px;
                                background: #303847;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #465675;
                                Text { text: root.active-workspace + " ⌄"; color: #dfe8fa; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.workspace-menu-open = !root.workspace-menu-open; } }
                            }
                            Rectangle {
                                width: 165px;
                                background: #303039;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #454550;
                                Text { text: root.active-mode + " ⌄"; color: #e0e1e8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.mode-open = !root.mode-open; } }
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                        }
                        if root.workspace-menu-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "VorynOS       /       Ungrouped"; color: #ededf0; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { root.active-workspace = root.active-workspace == "VorynOS" ? "Ungrouped" : "VorynOS"; root.workspace-menu-open = false; } }
                        }
                        if root.mode-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "Standard mode       /       Plan mode"; color: #ededf0; vertical-alignment: center; horizontal-alignment: center; }
                            TouchArea { clicked => { root.active-mode = root.active-mode == "Standard mode" ? "Plan mode" : "Standard mode"; root.mode-open = false; } }
                        }
                        Rectangle {
                            height: 124px;
                            background: #252528;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: #3d3d43;
                            VerticalLayout {
                                padding: 9px;
                                spacing: 4px;
                                LineEdit {
                                    text <=> root.prompt-text;
                                    placeholder-text: "Describe what you want to build";
                                    height: 64px;
                                    font-size: 15px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        background: #38383b;
                                        border-radius: 15px;
                                        Text { text: "+"; color: #e9eaf1; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 130px;
                                        background: #00000000;
                                        Text { text: "Full access ⌄"; color: #d3d4db; font-size: 13px; vertical-alignment: center; }
                                        TouchArea { clicked => { root.access-open = !root.access-open; } }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                    Rectangle {
                                        width: 188px;
                                        background: #00000000;
                                        Text { text: root.active-model + " ⌄"; color: #d3d4db; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        TouchArea { clicked => { root.model-open = !root.model-open; } }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        background: send-area.has-hover ? #536fa4 : #425e91;
                                        border-radius: 17px;
                                        Text { text: "↑"; color: #d3dce9; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                        send-area := TouchArea {
                                            clicked => {
                                                if root.prompt-text != "" {
                                                    root.send-prompt(root.prompt-text);
                                                    root.session-name = root.prompt-text;
                                                    root.has-session = true;
                                                    root.prompt-text = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.model-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "deepseek-v4-flash:free   /   Custom model"; color: #ededf0; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.active-model = root.active-model == "deepseek-v4-flash:free" ? "Custom model" : "deepseek-v4-flash:free"; root.model-open = false; } }
                        }
                        if root.access-open: Rectangle {
                            height: 30px; background: #2b2b30; border-radius: 6px;
                            Text { text: "Full access (visual only — no system permissions)"; color: #ededf0; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.access-open = false; } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
                Rectangle { vertical-stretch: 1.15; background: #00000000; }
            }
        }
    }
    if root.settings-open: Rectangle {
        background: #08080bc9;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: min(800px, parent.width - 48px);
            height: min(678px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #2b2b2e;
            border-radius: 22px;
            border-width: 1px;
            border-color: #414146;
            TouchArea { }
            VerticalLayout {
                padding: 22px;
                spacing: 18px;
                HorizontalLayout {
                    height: 28px;
                    Text { text: "Settings"; color: #f3f3f6; font-size: 17px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 175px; background: #343439; border-radius: 14px;
                        Text { text: "Configuration (preview)"; color: #c5c5ce; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 34px; background: transparent;
                        Text { text: "×"; color: #ededf2; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-open = false; } }
                    }
                }
                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        width: 164px;
                        spacing: 6px;
                        for item[i] in ["General", "Models", "Plugins", "Agent presets"]: Rectangle {
                            height: 40px;
                            border-radius: 9px;
                            background: root.settings-tab == i ? #45464c : transparent;
                            Text { text: item; x: 13px; color: root.settings-tab == i ? #ffffff : #d4d4da; font-size: 14px; vertical-alignment: center; }
                            TouchArea { clicked => { root.settings-tab = i; } }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                    Rectangle {
                        background: transparent;
                        VerticalLayout {
                            spacing: 12px;
                            if root.settings-tab == 0: VerticalLayout {
                                spacing: 13px;
                                Text { text: "General"; color: #f3f3f6; font-size: 19px; font-weight: 600; }
                                Text { text: "Default settings for new sessions"; color: #a9a9b3; font-size: 12px; }
                                Rectangle {
                                    height: 67px; background: #323236; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        VerticalLayout {
                                            Text { text: "Agent preset"; color: #eeeeef; font-size: 14px; }
                                            Text { text: "Choose the default agent mode"; color: #a7a7b0; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.active-mode + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.active-mode = root.active-mode == "Standard mode" ? "Plan mode" : "Standard mode"; } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 67px; background: #323236; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        VerticalLayout {
                                            Text { text: "Permission"; color: #eeeeef; font-size: 14px; }
                                            Text { text: "Default permission level"; color: #a7a7b0; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-permission + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-permission = root.settings-permission == "Full access" ? "Ask first" : "Full access"; } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 56px; background: #323236; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: "Language"; color: #eeeeef; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 145px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-language + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-language = root.settings-language == "English" ? "Português" : "English"; } }
                                        }
                                    }
                                }
                                Text { text: "Appearance"; color: #eeeeef; font-size: 14px; }
                                HorizontalLayout {
                                    height: 82px; spacing: 9px;
                                    for theme in ["Light", "Dark", "System"]: Rectangle {
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: root.settings-appearance == theme ? #9da7c4 : #4b4b51;
                                        background: root.settings-appearance == theme ? #414149 : #333337;
                                        Text { text: theme; color: #eeeeef; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.settings-appearance = theme; } }
                                    }
                                }
                                Rectangle {
                                    height: 62px; background: #323236; border-radius: 10px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: "Enter behavior while busy"; color: #eeeeef; font-size: 13px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 120px; background: #414148; border-radius: 18px;
                                            Text { text: root.settings-enter + " ⌄"; color: #f1f1f4; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { root.settings-enter = root.settings-enter == "Queue" ? "Send" : "Queue"; } }
                                        }
                                    }
                                }
                            }
                            if root.settings-tab == 1: VerticalLayout {
                                spacing: 12px;
                                Text { text: "Models"; color: #f3f3f6; font-size: 19px; font-weight: 600; }
                                Text { text: "Manage AI providers (configuration preview)."; color: #aaaaaf; font-size: 12px; }
                                for provider in ["DeepSeek", "OpenRouter", "Custom provider"]: Rectangle {
                                    height: 54px; background: #323236; border-radius: 11px;
                                    border-width: 1px; border-color: #48484e;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: provider; color: #f2f2f4; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 62px; background: #424249; border-radius: 13px;
                                            Text { text: "Edit"; color: #eeeeef; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.settings-provider = provider; } }
                                        }
                                    }
                                }
                                if root.settings-provider != "": Rectangle {
                                    height: 48px; background: #3a3b45; border-radius: 9px;
                                    Text { text: root.settings-provider + ": API configuration coming soon"; color: #cdd6ed; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    height: 44px; background: #373740; border-radius: 10px;
                                    Text { text: "+ Add provider (coming soon)"; color: #c7c7d2; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
                                }
                            }
                            if root.settings-tab == 2: VerticalLayout {
                                spacing: 12px;
                                Text { text: "Plugins"; color: #f3f3f6; font-size: 19px; font-weight: 600; }
                                Text { text: "Available plugin categories (preview)."; color: #aaaaaf; font-size: 12px; }
                                for plugin in ["Shell", "Agent loop", "Web search"]: Rectangle {
                                    height: 74px; background: #343438; border-radius: 12px;
                                    border-width: 1px; border-color: #4a4a51;
                                    VerticalLayout {
                                        padding: 12px; spacing: 4px;
                                        Text { text: plugin; color: #eeeeef; font-size: 15px; font-weight: 600; }
                                        Text { text: "Not connected — configuration coming soon"; color: #a7a7b0; font-size: 12px; }
                                    }
                                }
                            }
                            if root.settings-tab == 3: VerticalLayout {
                                spacing: 12px;
                                Text { text: "Agent presets"; color: #f3f3f6; font-size: 19px; font-weight: 600; }
                                Text { text: "Choose a preset for future sessions (preview)."; color: #aaaaaf; font-size: 12px; }
                                for preset in ["Standard mode", "PTC mode", "Minimal mode", "Creator mode"]: Rectangle {
                                    height: 66px; background: #343438; border-radius: 12px;
                                    border-width: 1px; border-color: root.active-mode == preset ? #8d9bbd : #4a4a51;
                                    HorizontalLayout {
                                        padding: 12px;
                                        Text { text: preset; color: #eeeeef; font-size: 14px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.active-mode == preset ? "Selected" : "Select"; color: #b8c4e1; font-size: 12px; vertical-alignment: center; }
                                    }
                                    TouchArea { clicked => { root.active-mode = preset; } }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }
    }

}
